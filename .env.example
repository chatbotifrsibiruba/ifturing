# Copie este arquivo para .env e preencha os valores

# Pasta com os PDFs do processo seletivo
PASTA_DOCS=./documentos

# Pasta onde o índice ChromaDB será salvo
PASTA_CHROMA=./chroma_data

# URL do servidor Ollama
OLLAMA_URL=http://localhost:11434

# Várias instâncias do Ollama, separadas por vírgula (opcional; vazio = só OLLAMA_URL). Vai para a menos ocupada,
# com failover. Ver GPUS.md
# OLLAMA_URLS=http://localhost:11434,http://localhost:11435

# Dispositivo do embedder (cpu | cuda). Ver GPUS.md
# EMBEDDER_DEVICE=cpu

# Reranker opcional (cross-encoder, sempre fp32). Desligado por padrão. Ver GPUS.md
# RERANKER_ATIVO=0
# RERANKER_MODELO=BAAI/bge-reranker-v2-m3
# RERANKER_CANDIDATOS=15
# RERANKER_MAX_LENGTH=256
# RERANKER_DEVICE=cpu

# Modelo padrão do Ollama (usado no modo usuário final)
MODELO_OLLAMA=llama3:latest

# Modelo padrão do app (id do Ollama). Padrão: gemma3:4b. Se não estiver instalado, o app usa o primeiro da lista
MODELO_PADRAO=gemma3:4b

# Senha do painel administrativo (troque antes de ir para produção)
ADMIN_PASSWORD=ifturing2026
